digraph behavior {
  rankdir=LR;
  node [shape=box];
  n_1_00 [label="1@00 / 0"];
  n_2_01 [label="2@01 / 1"];
  sink_undefined [label="UNDEFINED", shape=oval, color=red, fontcolor=red];
  n_1_00 -> n_2_01 [label="x2"];
  n_1_00 -> sink_undefined [label="x1", style=dashed, color=red];
  n_2_01 -> n_1_00 [label="x2"];
  n_2_01 -> sink_undefined [label="x1", style=dashed, color=red];
}
